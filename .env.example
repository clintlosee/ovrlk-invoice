# Names only. Real values live in the Render service environment, never in git.
# Locally, copy this file to .env and fill it in. .env is gitignored.

# libSQL. Local file for dev and tests. Turso URL (libsql://...) in production.
DATABASE_URL=file:local.db
# Required when DATABASE_URL is a hosted Turso database. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin, no trailing slash. http://localhost:3000 locally; the Render URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Resend sends the sign-in code. Without a key, local dev prints the code in the server log.
RESEND_API_KEY=
EMAIL_FROM=

# Server rejects registration unless this is the string true. The sign-up page follows the same flag.
ALLOW_SIGN_UP=false

# Used only by `pnpm seed`. Not read by the web process.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
SEED_BUSINESS_NAME=
# IANA time zone. Defaults to America/Denver when unset.
SEED_BUSINESS_TIMEZONE=America/Denver
